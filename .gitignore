# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.cursorrules
.cursor/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
AGENTS.md

context/*
*:Zone.Identifier

# Client reports. This repository is PUBLIC, so only the sealed .enc envelopes
# are ever committed — see content/reports/README.md. A plaintext report dropped
# in here by mistake would publish the whole thing on GitHub, passcode gate or
# not, and it would stay in the history long after being deleted. Ignored so it
# cannot happen by accident.
content/reports/*.html
content/reports/*.htm
content/reports/*.json
content/reports/*.md
!content/reports/README.md
